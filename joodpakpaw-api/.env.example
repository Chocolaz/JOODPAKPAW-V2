# ==============================================================================
# JoodPakPaw Core Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Port & Environment
PORT=8000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connection (Prisma)
# ------------------------------------------------------------------------------
# Local Docker Postgres:
DATABASE_URL="postgresql://joodpakpaw:joodpakpaw_password@localhost:5432/joodpakpaw_db?schema=public"

# Cloud Supabase / Neon Serverless Postgres (Uncomment for production / free cloud):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Redis Cache & Job Queue
# ------------------------------------------------------------------------------
# Local Docker Redis:
REDIS_URL="redis://localhost:6379"

# Upstash Free Redis:
# REDIS_URL="rediss://default:[token]@[host].upstash.io:6379"

# NOTE: If REDIS_URL is left empty or omitted, joodpakpaw-api automatically
# falls back to an in-memory cache and in-process cron scheduler with zero crash.

# ------------------------------------------------------------------------------
# 3. S3-Compatible Object Storage (MinIO / Cloudflare R2 / Supabase Storage)
# ------------------------------------------------------------------------------
# Local MinIO:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET="joodpakpaw-media"
S3_PUBLIC_URL="http://localhost:9000/joodpakpaw-media"
S3_FORCE_PATH_STYLE="true"

# Cloudflare R2 (Uncomment for free-tier 10GB cloud storage):
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY="<R2_ACCESS_KEY_ID>"
# S3_SECRET_KEY="<R2_SECRET_ACCESS_KEY>"
# S3_BUCKET="joodpakpaw-media"
# S3_PUBLIC_URL="https://pub-<hash>.r2.dev"
# S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="joodpakpaw_super_secret_jwt_key_2026_dev"
JWT_REFRESH_SECRET="joodpakpaw_super_secret_refresh_jwt_key_2026_dev"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. External Services & URLs
# ------------------------------------------------------------------------------
# Frontend client URL (CORS allowed origin)
FRONTEND_URL="http://localhost:3000"

# Python FastAPI Machine Learning Recommendation Service (joodpakpaw-ml)
ML_SERVICE_URL="http://localhost:5000"
ML_TIMEOUT_MS="1500"
