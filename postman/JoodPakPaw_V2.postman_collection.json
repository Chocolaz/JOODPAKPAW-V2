        {
          "name": "API v1 Subsystems Discovery",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns available endpoints\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.version).to.eql(\"v1\");",
                  "    pm.expect(json.endpoints).to.have.property(\"auth\");",
                  "    pm.expect(json.endpoints).to.have.property(\"users\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1"]
            },
            "description": "List all active API v1 subsystem endpoints."
          },
          "response": []
        },
        {
          "name": "404 Not Found Standard Format",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Standard error format\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(\"ROUTE_NOT_FOUND\");",
                  "});"
