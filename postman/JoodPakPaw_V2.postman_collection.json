      "item": [
        {
          "name": "Root Service Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service is running\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.service).to.eql(\"joodpakpaw-api\");",
                  "    pm.expect(json.status).to.eql(\"online\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Check root service identification."
          },
          "response": []
        },
        {
          "name": "Health Check (System & Database)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Overall status is UP\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"UP\");",
                  "});"
