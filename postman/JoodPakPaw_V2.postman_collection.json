    {
      "name": "01 - Auth & User Profile (PBI-04 & PBI-05 - PASS)",
      "description": "JWT Authentication, OTP Registration, Password Reset, Profile, S3 WebP Avatar Upload, and Change Password APIs (19/19 QA Tests Passed)",
      "item": [
        {
          "name": "Sign Up (Register & Generate OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.otp) {",
                  "    pm.environment.set(\"last_otp\", json.otp);",
                  "}",
                  "if (json.refCode) {",
                  "    pm.environment.set(\"last_ref_code\", json.refCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.guest@joodpakpaw.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"firstname\": \"สมหวัง\",\n  \"lastname\": \"รักสัตว์\",\n  \"phone\": \"0899876543\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-up"]
            },
            "description": "Register a new user and generate 6-digit OTP + refCode. Returns T-2007 on validation error, A-3003 on duplicate email, A-3004 on duplicate phone."
          },
          "response": []
        },
        {
          "name": "Verify OTP (Complete Registration)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", json.accessToken);",
                  "}",
                  "if (json.refreshToken) {",
                  "    pm.environment.set(\"refresh_token\", json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.guest@joodpakpaw.com\",\n  \"otp\": \"{{last_otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            },
            "description": "Verify 6-digit OTP and issue JWT accessToken & refreshToken."
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.otp) {",
                  "    pm.environment.set(\"last_otp\", json.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.guest@joodpakpaw.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "description": "Generate new 6-digit OTP and refCode for user."
          },
          "response": []
        },
        {
          "name": "Sign In (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var token = json.accessToken || (json.data && json.data.accessToken);",
                  "if (token) {",
                  "    pm.environment.set(\"jwt_token\", token);",
                  "}",
                  "var refresh = json.refreshToken || (json.data && json.data.refreshToken);",
                  "if (refresh) {",
                  "    pm.environment.set(\"refresh_token\", refresh);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "    pm.environment.set(\"user_id\", String(json.user.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-in"]
            },
            "description": "Sign in as Admin. Saves `jwt_token`, `refresh_token`, and `user_id` to environment. Returns A-3001 (401) on invalid credentials."
          },
          "response": []
        },
        {
          "name": "Sign In (Host)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var token = json.accessToken || (json.data && json.data.accessToken);",
                  "if (token) {",
                  "    pm.environment.set(\"jwt_token\", token);",
                  "}",
                  "var refresh = json.refreshToken || (json.data && json.data.refreshToken);",
                  "if (refresh) {",
                  "    pm.environment.set(\"refresh_token\", refresh);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "    pm.environment.set(\"user_id\", String(json.user.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{host_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-in",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-in"]
            },
            "description": "Sign in as verified Host with demo seed account."
          },
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.environment.set(\"jwt_token\", json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "description": "Rotate/issue a new accessToken from a valid refreshToken."
          },
          "response": []
        },
        {
          "name": "Forgot Password (Request Reset Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.resetPasswordToken) {",
                  "    pm.environment.set(\"reset_password_token\", json.resetPasswordToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guest_email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Request password reset token. Returns DB-1002 (404) if email is not registered."
          },
          "response": []
        },
        {
          "name": "Reset Password (Consume Reset Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guest_email}}\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"resetPasswordToken\": \"{{reset_password_token}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Reset password using token. Returns A-3010 (400) if token is expired or already used."
          },
          "response": []
        },
        {
          "name": "Get Authenticated User Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set(\"user_id\", String(json.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            },
            "description": "Fetch authenticated user profile (`ProfileResponse`), roles, and verification status."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"{{user_password}}\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}", "change-password"]
            },
            "description": "Change password for authenticated user. Returns A-3011 on wrong oldPassword, A-3012 if newPassword equals oldPassword, and 403 A-3007 on IDOR attempt."
          },
          "response": []
        },
        {
          "name": "Update User Profile & WebP Avatar (PBI-05)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Returns updated UserProfile\", function () {",
                  "    pm.expect(json.data).to.be.an(\"object\");",
                  "    pm.expect(json.data.firstName).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "สมชาย",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "ใจดีมาก",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "0812345678",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": [],
                  "description": "Optional profile image (automatically resized and converted to .webp on S3/MinIO)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}"]
            },
            "description": "Update user profile fields and upload avatar image (auto-converted to .webp via sharp + @aws-sdk/client-s3). Returns A-3004 (409) on duplicate phone, T-2007 (400) on invalid phone, and A-3007 (403) on IDOR attempt."
          },
          "response": []
        }
      ]
