# JoodPakPaw Frontend Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel Dashboard

# Core Backend REST API Base URL (keep trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/

# Root Base Path (leave empty for root '/' on Vercel & Local Dev)
NEXT_PUBLIC_BASE_PATH=

# Socket.IO Real-Time Server Base URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
